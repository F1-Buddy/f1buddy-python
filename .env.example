# Required
DISCORD_TOKEN=
# Comma-separated Discord user ids allowed to run f1$sync
ADMIN_USER_IDS=1254240994665304094,1384610184063746080

# Optional
# Channel that receives operational alerts (for example: the FIA page stopped parsing)
OWNER_ALERT_CHANNEL_ID=
# Channel for automatic FIA document posts. Same effect as running /setup fia in that server.
FIA_CHANNEL_ID=
# Enables the AI analysis option on /telemetry
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LOG_LEVEL=INFO
# Where the database and caches live. Leave unset in Docker (the image uses /data).
# DATA_DIR=./data
